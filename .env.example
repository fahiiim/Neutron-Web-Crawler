# ==============================================================================
# NEUTRON SEARCH ENGINE - LEAPCELL & GITHUB PAGES CONFIGURATION
# ==============================================================================

ENVIRONMENT=production
PORT=8080

# 1. Shared Internal RPC Key (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
REQUIRE_INTERNAL_API_KEY=true

# 2. Turso Database (used by services/search and services/crawler)
TURSO_DATABASE_URL=libsql://neutron-search-fahiiim.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# 3. Optional Gemini Grounded Synthesis (used by services/search; falls back cleanly if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 4. Microservice ConnectRPC/gRPC Endpoints (used by services/gateway)
SEARCH_SERVICE_URL=https://neutron-search.leapcell.dev
CRAWLER_SERVICE_URL=https://neutron-crawler.leapcell.dev
RPC_PROTOCOL=connect

# 4. CORS Origins allowed to call Gateway (GitHub Pages + local Vite dev)
CORS_ALLOW_ORIGINS=https://fahiiim.github.io,http://localhost:5173

# 5. Crawler Serverless Safety Settings (keep background loop false on Leapcell)
BACKGROUND_CRAWLER_ENABLED=false
MAX_CONCURRENT_JIT_FETCHES=12
# BRAVE_SEARCH_API_KEY=
