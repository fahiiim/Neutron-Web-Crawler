# ==============================================================================
# NEUTRON SEARCH ENGINE - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=production
INTERNAL_API_KEY=your_generated_64_character_hex_secret

# ==============================================================================
# DATABASE: TURSO (LibSQL with FTS5 - 9 GB Free Tier)
# ==============================================================================
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# ==============================================================================
# OBJECT STORAGE: CLOUDFLARE R2 (10 GB Free Storage, $0 Egress)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=neutron-page-cache
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ==============================================================================
# HUGGING FACE SPACES MICROSERVICE INTERCONNECT URLS
# When deploying to Hugging Face, set these to your live Space URLs:
# ==============================================================================
CRAWLER_SERVICE_URL=https://your-username-neutron-crawler.hf.space
RENDERER_SERVICE_URL=https://your-username-neutron-renderer.hf.space
