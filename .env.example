# ==============================================================================
# NEUTRON SEARCH ENGINE - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

ENVIRONMENT=development
PORT=8000
INTERNAL_API_KEY=neutron_secret_key_change_me_to_random_hex_32

# Database backend selection: "turso" (recommended: 9GB free, FTS5) OR "supabase" (federated postgres)
DATABASE_BACKEND=turso

# ==============================================================================
# OPTION 1: TURSO CONFIGURATION (LibSQL with FTS5)
# ==============================================================================
TURSO_DATABASE_URL=libsql://your-db-name-your-user.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# ==============================================================================
# OPTION 2: SUPABASE CONFIGURATION (Federated PostgreSQL)
# ==============================================================================
# Control DB (for domains, frontier_queue, shard_registry)
SUPA_CONTROL_DB_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Federated Shards: Comma-separated list: shard_id|db_connection_uri|rest_url|service_key
FEDERATED_SHARDS=1|postgresql://postgres.shard1:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres|https://shard1.supabase.co|service_role_key_1

# ==============================================================================
# OBJECT STORAGE: CLOUDFLARE R2 (S3-Compatible 10GB Free Storage)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=neutron-page-cache
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# ==============================================================================
# CRAWLER & SEARCH ENGINE TUNING
# ==============================================================================
MAX_CONCURRENT_JIT_FETCHES=12
DEFAULT_CRAWL_DELAY_MS=1500
SHARD_CAPACITY_LIMIT_MB=450.0
BACKGROUND_CRAWLER_ENABLED=true
MAX_PAGES_PER_DAY=27400
