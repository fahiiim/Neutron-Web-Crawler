# ==============================================================================
# NEUTRON SEARCH ENGINE - ZERO-CARD MASTER CONFIGURATION
# ==============================================================================

ENVIRONMENT=production

# 1. Internal Security Key (REQUIRED - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
INTERNAL_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# 2. Turso Database (100% Free, NO Credit Card Required, 9 GB Storage)
TURSO_DATABASE_URL=libsql://neutron-search-fahiiim.turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token

# 3. Microservice Interconnect Endpoints (Direct Hugging Face Space App URLs)
CRAWLER_SERVICE_URL=https://fahiiim-neutron-crawler.hf.space
RENDERER_SERVICE_URL=https://fahiiim-neutron-renderer.hf.space

# 4. Optional Discovery & Crawler Tuning
# BRAVE_SEARCH_API_KEY=
MAX_CONCURRENT_JIT_FETCHES=12
BACKGROUND_CRAWLER_ENABLED=true
BACKGROUND_FETCH_INTERVAL_SECONDS=3.1
